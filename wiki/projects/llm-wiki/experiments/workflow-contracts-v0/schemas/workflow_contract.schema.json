{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow_contract.schema.json",
  "title": "LLM-Wiki Workflow Contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "canonical_markdown",
    "trigger",
    "start_file",
    "source_of_truth",
    "required_reads",
    "conditional_reads",
    "allowed_writes",
    "forbidden_writes",
    "approval_gates",
    "evidence_before_done",
    "closeout_rules",
    "drift_checks"
  ],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "canonical_markdown": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "start_file": { "type": "string", "minLength": 1 },
    "source_of_truth": { "type": "string", "minLength": 1 },
    "required_reads": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conditional_reads": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_writes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_writes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approval_gates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_before_done": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closeout_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "drift_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "must_include", "remediation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "must_include": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

